# ----- Claude / editor / IDE -----
.claude/
.vscode/
.vs/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates

# ----- Design notes (local, not for sharing) -----
_docs/_design/

# ----- .NET build output -----
# Note: root /bin is intentionally NOT ignored — it holds vendored
# third-party DLLs alongside build output. Revisit once modernised.
**/obj/
Eden/**/bin/
addon-modules/**/bin/
Prebuild/**/bin/

# (Legacy) Prebuild-generated files used to be ignored here. Prebuild has
# been dropped in favour of tracked SDK-style `.csproj` + `.sln` files, so
# those are now first-class repo contents.

# ----- Build artefacts -----
*.pdb
*.mdb
*.cache
*.log
*.tmp
*.swp
*.bak

# ----- NuGet -----
packages/
*.nupkg
.nuget/

# ----- Godot (future Eden.Viewer project) -----
.godot/
.import/
export.cfg
export_presets.cfg
*.translation
mono_crash.*.json

# ----- Test / coverage output -----
TestResults/
coverage/
*.coverage
*.coveragexml

# ----- OS cruft -----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ----- Secrets / local env -----
*.env
.env.local
.env.*.local
secrets/
*.key
*.pem

# ----- Runtime / user data -----
# OpenSim drops these into bin/ at runtime — harmless but noisy
bin/Regions/
bin/ScriptEngines/
bin/addon-modules/
bin/maptiles/
bin/*.db
bin/*.log
bin/OpenSim.log.*
