# ----- Claude / editor / IDE -----
.claude/
.vscode/
.vs/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates

# ----- Design notes (local, not for sharing) -----
_docs/_design/

# ----- .NET / Godot build output -----
**/obj/
**/bin/

# ----- Published artifacts (produced by scripts/build.ps1 / build.sh) -----
/build/*
!/build/README.md
!/build/.gitkeep

# ----- Build artefacts -----
*.pdb
*.mdb
*.cache
*.log
*.tmp
*.swp
*.bak

# ----- NuGet -----
packages/
*.nupkg
.nuget/

# ----- Godot (Eden.Viewer project) -----
.godot/
.import/
export.cfg
export_presets.cfg
*.translation
mono_crash.*.json
Eden.Viewer/.godot/
Eden.Viewer/.mono/
Eden.Viewer/bin/
Eden.Viewer/obj/

# ----- Test / coverage output -----
TestResults/
coverage/
*.coverage
*.coveragexml

# ----- OS cruft -----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ----- Secrets / local env -----
*.env
.env.local
.env.*.local
secrets/
*.key
*.pem

# ----- Godot backups on SDK upgrade -----
**/*.csproj.old
