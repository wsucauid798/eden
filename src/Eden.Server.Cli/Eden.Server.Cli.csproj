<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Eden.Server.Cli</RootNamespace>

    <!-- Ready for self-contained publish so the target box does
         not need a .NET runtime install. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eden.Launcher\Eden.Launcher.csproj" />
    <ProjectReference Include="..\Eden.Logging\Eden.Logging.csproj" />
  </ItemGroup>

</Project>
