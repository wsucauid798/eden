<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eden.Shared\Eden.Shared.csproj" />
  </ItemGroup>

  <!-- Host/ is a separate project (Eden.Scripting.Host.csproj) nested inside
       this directory because its name is literally a child of this one.
       Exclude it from our default globbing. -->
  <ItemGroup>
    <Compile Remove="Host/**/*.cs" />
    <None    Remove="Host/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
