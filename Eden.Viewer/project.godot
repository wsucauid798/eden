; Engine configuration file.
; Generated by, and editable in, the Godot editor.
; Opening this project in Godot 4 will flesh out the .godot/ cache and
; generate the assembly shims for C#.

config_version=5

[application]

config/name="Eden"
config/description="A platform for creating virtual worlds."
config/version="0.0.1"
run/main_scene="res://Scripts/Main.tscn"

[dotnet]

project/assembly_name="Eden.Viewer"

[rendering]

renderer/rendering_method="forward_plus"
